POSTGRES_PASSWORD=postgres
# Signs login tokens (user-service) and validates them (api-gateway). At least 32 characters;
# generate one with: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars

# ---- Email ----
# Default: Mailpit catches every email locally — open http://localhost:8025. Nothing to configure.
# Real delivery through Resend (https://resend.com/api-keys): uncomment all six lines.
# Without a verified domain Resend only delivers to your own Resend account address,
# and MAIL_FROM must be onboarding@resend.dev.
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_your_api_key
# MAIL_FROM=onboarding@resend.dev
# MAIL_SMTP_AUTH=true

# ---- SMS (optional) ----
# Twilio (https://console.twilio.com). Trial accounts only deliver to verified numbers.
# Accounts need a phone number in international format, e.g. +905551234567.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15005550006
